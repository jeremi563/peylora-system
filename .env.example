# ==============================================================================
# SAFARICOM DARAJA API CONFIGURATION
# ==============================================================================
# Get these from Safaricom Developer Portal (https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# The public HTTPS URL where Safaricom Daraja sends STK Push callback results.
# Development: use ngrok / cloudflared (e.g. https://xxxx.ngrok-free.app/api/mpesa/callback)
# Production (Render): https://<your-render-service>.onrender.com/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-public-url.onrender.com/api/mpesa/callback
MPESA_REQUEST_TIMEOUT_MS=15000

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ==============================================================================
# Local Docker development:
DATABASE_URL=postgresql://daraja:daraja@localhost:5433/daraja_dev

# Supabase Production (Transaction Pooler - Recommended for serverless/containers):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Supabase Direct Connection:
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10

# ==============================================================================
# REDIS & QUEUE CONFIGURATION
# ==============================================================================
REDIS_URL=redis://localhost:6379
# In production on Render/Upstash, set RATE_LIMIT_REDIS_URL to share rate limits across instances:
RATE_LIMIT_REDIS_URL=

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Must be at least 32 cryptographically random characters in production
AUTH_JWT_SECRET=replace_with_at_least_32_random_characters_secret_key_123

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server port (Render automatically provides PORT=10000)
PORT=5000

# Public URL of the frontend / customer payment interface
PUBLIC_APP_URL=http://localhost:5000

# Comma-separated list of allowed frontend origins (Vercel, localhost, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Set to 1 behind Render / Cloudflare / Nginx reverse proxy so Express trusts HTTPS headers
TRUST_PROXY_HOPS=1

# Expose Swagger interactive docs at /api/docs (set to true in production if desired)
ENABLE_API_DOCS=true

# ==============================================================================
# EMAIL / SMTP NOTIFICATIONS
# ==============================================================================
# Development: Mailtrap / Ethereal / Console fallback
# Production: Resend / SendGrid / Amazon SES
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="M-Pesa Payments <noreply@yourdomain.com>"

# ==============================================================================
# RATE LIMITING THRESHOLDS
# ==============================================================================
API_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=10
PASSWORD_RATE_LIMIT=5
PAYMENT_RATE_LIMIT=10
PUBLIC_PAYMENT_RATE_LIMIT=8

# ==============================================================================
# ASYNC WORKERS & QUEUES TUNING
# ==============================================================================
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_POLL_INTERVAL_MS=2000
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_LEASE_SECONDS=300

WEBHOOK_BATCH_SIZE=20
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_LEASE_SECONDS=300